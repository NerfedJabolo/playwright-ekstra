# Siseveebi sisselogimise tunnused (vajalikud ülesannetele 1 ja 2).
# Kopeeri see fail nimega .env ja täida väärtused:
#     cp .env.example .env
# Fail .env on .gitignore'is ja ei lähe kunagi reposse ega aruandesse.

SISEVEEB_USER=sinu.kasutajatunnus
SISEVEEB_PASS=sinu.parool

# Valikuline: õpetajate nimed, keda tunniplaani testis kontrollitakse (komaga eraldatud).
# SISEVEEB_OPETAJAD=Aly Valvas,Maret Vaabel,Max Frolov
